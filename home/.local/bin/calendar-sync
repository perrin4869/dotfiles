#!/bin/sh
# Mirror the CalDAV calendars for khal; cron has a minimal PATH, so use the installed binary directly.
set -eu

binary=$HOME/.local/bin/vdirsyncer
[ -x "$binary" ] || exit 0

config=${XDG_CONFIG_HOME:-$HOME/.config}/vdirsyncer/config
[ -f "$config" ] || exit 0

# vdirsyncer writes this after the first authorization; until then a fresh setup would only log errors
[ -f "$HOME/.local/share/vdirsyncer/google-token" ] || exit 0

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/calendar-sync
mkdir -p "$state_dir"

# 75 means another sync still holds the lock, which is not an error
if flock -n -E 75 "$state_dir/lock" "$binary" sync; then
	exit 0
else
	status=$?
	[ "$status" -eq 75 ] && exit 0
	exit "$status"
fi
