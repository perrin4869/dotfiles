#!/usr/bin/env bash
# gh, gated: stowed to ~/.pi/agent/bin/gh, a directory pi puts first on the PATH of the commands it runs, so nothing
# outside pi sees it. The real gh is whatever is left on PATH once this directory is dropped, so none is baked in.
set -u

self=$(cd -- "$(dirname -- "$0")" && pwd)
rest=
ifs=$IFS
IFS=:
for dir in $PATH; do
	[ "$dir" = "$self" ] && continue
	rest=${rest:+$rest:}$dir
done
IFS=$ifs
real=$(PATH=$rest command -v gh) || { echo "gh-approval: no gh on PATH" >&2; exit 127; }
# the directory is dropped above, but a symlinked or differently spelled entry would leave the wrapper here, and execing
# itself would ask again and again
[ "$real" -ef "$0" ] && { echo "gh-approval: the only gh on PATH is this wrapper" >&2; exit 127; }

# a unix socket rather than a loopback port: a sandboxed command has a network namespace of its own
endpoint=${GH_APPROVAL_SOCKET:-}
verdict=
if [ -n "$endpoint" ]; then
	command -v socat >/dev/null || { echo "gh-approval: socat is missing, so nothing was sent" >&2; exit 1; }
	# without shut-none socat half-closes once its input ends, which looks like a hang-up; and it stops waiting 0.5s later
	if ! verdict=$(printf '%s\0' "$PWD" "${GH_REPO:-}" "$#" "$@" | socat -t 86400 - UNIX-CONNECT:"$endpoint",shut-none 2>/dev/null); then
		verdict=
	fi
fi

case $verdict in
allow) exec "$real" "$@" ;;
deny\ *)
	echo "gh-approval: ${verdict#deny }" >&2
	exit 1
	;;
esac

# pi named an endpoint and it did not answer: refusing is the point, where running unchecked would defeat the gate
if [ -n "$endpoint" ]; then
	echo "gh-approval: the session did not answer; nothing was sent" >&2
	exit 1
fi

echo "gh-approval: no pi session to ask, running gh unchecked" >&2
exec "$real" "$@"
