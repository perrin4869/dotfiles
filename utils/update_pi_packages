#!/usr/bin/env node
// Bump each pinned `npm:<name>@<version>` package in pi's settings to its latest release.
// `pi update` leaves pinned versions alone, so this does it for the update PRs.
// Prints a markdown PR body: one bullet per bump, with release notes when GitHub has them.
import { execFileSync } from 'node:child_process';
import { writeFile } from 'node:fs/promises';
import extensions from '../home/.pi/agent/extensions/package.json' with { type: 'json' };
import settings from '../home/.pi/agent/settings.json' with { type: 'json' };

const PINNED = /^npm:((?:@[^/@]+\/)?[^@]+)@(\d[^@]*)$/;

// at most this many characters of notes per package, so the whole body stays under what GitHub accepts
const NOTES_PER_PACKAGE = 4000;
const NOTES_BUDGET = 60000;

// a repo tags every release the same way; these spellings are tried newest version first
const TAG_FORMATS = [
	(name, version) => `v${version}`,
	(_name, version) => version,
	(name, version) => `${name}@${version}`,
];

const registry = async (name) => {
	const response = await fetch(`https://registry.npmjs.org/${name.replace('/', '%2F')}`);
	if (!response.ok) throw new Error(`${name}: registry answered ${response.status}`);
	return response.json();
};

// the release a repo has for a tag, or undefined when it has none
const release = async (repo, tag) => {
	const response = await fetch(`https://api.github.com/repos/${repo}/releases/tags/${encodeURIComponent(tag)}`, {
		headers: process.env.GITHUB_TOKEN ? { authorization: `Bearer ${process.env.GITHUB_TOKEN}` } : {},
	});
	if (response.status === 404) return undefined;
	if (!response.ok) throw new Error(`GitHub answered ${response.status} for ${repo} ${tag}`);
	return response.json();
};

// `owner/repo` of a package's repository field, when it is on GitHub
const githubRepo = ({ repository }) => {
	const url = typeof repository === 'string' ? repository : repository?.url;
	return /github\.com[/:]([^/]+\/[^/.]+)/.exec(url ?? '')?.[1];
};

const parseVersion = (version) => /^(\d+)\.(\d+)\.(\d+)$/.exec(version)?.slice(1).map(Number);
const compareVersions = (a, b) => a[0] - b[0] || a[1] - b[1] || a[2] - b[2];

// stable versions published after `from` up to `to`, newest first
const versionsBetween = (versions, from, to) =>
	Object.keys(versions)
		.map((version) => [version, parseVersion(version)])
		.filter(([, parsed]) => parsed && compareVersions(parsed, from) > 0 && compareVersions(parsed, to) <= 0)
		.sort(([, a], [, b]) => compareVersions(b, a))
		.map(([version]) => version);

// release notes are written for their own repo: point its issue references there, and keep mentions from notifying
const relink = (repo, body) =>
	body
		.replace(/(^|[^\w/`])#(\d+)\b/g, `$1${repo}#$2`)
		.replace(/(^|[^\w/`])@([A-Za-z\d](?:[A-Za-z\d-]*[A-Za-z\d])?)\b(?![./]\w)/g, '$1`@$2`');

// one version's section of the body, or '' when that release has no notes
const note = (repo, version, { body, html_url }) =>
	body?.trim() ? `### [${version}](${html_url})\n\n${relink(repo, body.trim())}` : '';

// the releases of every version in `between`, once the tag format is known; undefined when the repo publishes none
async function releases(name, repo, between) {
	for (const format of TAG_FORMATS) {
		const newest = await release(repo, format(name, between[0]));
		if (!newest) continue;
		const older = await Promise.all(between.slice(1).map((version) => release(repo, format(name, version))));
		return [newest, ...older];
	}
	return undefined;
}

// Release notes of every stable version after `current`, up to and including `version`, newest first, cut at whole
// versions to fit `limit`; empty when unavailable
async function releaseNotes(name, current, version, document, limit) {
	const repo = githubRepo(document);
	const [from, to] = [parseVersion(current), parseVersion(version)];
	if (!repo || !from || !to) return '';
	const between = versionsBetween(document.versions, from, to);
	const found = between.length > 0 ? await releases(name, repo, between) : undefined;
	if (!found) return '';

	const kept = [];
	let size = 0;
	for (const [index, released] of found.entries()) {
		const text = released ? note(repo, between[index], released) : '';
		if (!text) continue;
		size += (kept.length > 0 ? 2 : 0) + text.length;
		if (size > limit) return kept.join('\n\n') + `\n\n[More release notes](https://github.com/${repo}/releases)`;
		kept.push(text);
	}
	return kept.join('\n\n');
}

const bumpLine = ({ name, current, version }) =>
	`Bump [${name}](https://www.npmjs.com/package/${name}) from ${current} to ${version}`;

const bumps = [];

const packages = await Promise.all(
	(settings.packages ?? []).map(async (spec) => {
		const match = typeof spec === 'string' ? PINNED.exec(spec) : null;
		if (!match) return spec;
		const [, name, current] = match;
		const document = await registry(name);
		const version = document['dist-tags'].latest;
		if (version !== current) bumps.push({ name, current, version, document });
		return `npm:${name}@${version}`;
	}),
);

// pi records the last seen version per package on boot, so move those records along with the pins
// instead of leaving the next launch to rewrite settings.json
const bumped = new Map(bumps.map(({ name, current, version }) => [`npm:${name}@${current}`, { name, version }]));
const extensionChangelogVersions = Object.fromEntries(
	Object.entries(settings.extensionChangelogVersions ?? {}).map(([key, seen]) => {
		const { source, ...rest } = JSON.parse(key);
		const next = bumped.get(source);
		return next ? [JSON.stringify({ source: `npm:${next.name}@${next.version}`, ...rest }), next.version] : [key, seen];
	}),
);

// pi writes the file this way, so an update only shows the changed versions
await writeFile(
	new URL('../home/.pi/agent/settings.json', import.meta.url),
	JSON.stringify({ ...settings, packages, extensionChangelogVersions }, null, 2),
);

// the extension tests run against these packages' internals, so they follow the pinned versions
const tested = bumps
	.filter(({ name }) => name in extensions.devDependencies)
	.map(({ name, version }) => `${name}@${version}`);
if (tested.length > 0) {
	execFileSync(
		'npm',
		['install', '--workspace', 'home/.pi/agent/extensions', '--save-dev', '--save-exact', '--ignore-scripts', ...tested],
		// stdout is the PR body
		{ cwd: new URL('..', import.meta.url), stdio: ['ignore', 'ignore', 'inherit'] },
	);
}

const limit = Math.min(NOTES_PER_PACKAGE, Math.floor(NOTES_BUDGET / Math.max(bumps.length, 1)));
for (const bump of bumps.sort((a, b) => a.name.localeCompare(b.name))) {
	// a missing release should not hold back the bump
	const notes = await releaseNotes(bump.name, bump.current, bump.version, bump.document, limit).catch((error) => {
		console.error(`${bump.name}: no release notes: ${error.message}`);
		return '';
	});
	console.log(notes ? `<details>\n<summary>${bumpLine(bump)}</summary>\n\n${notes}\n</details>\n` : `- ${bumpLine(bump)}`);
}
