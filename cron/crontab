# === user crontab (managed by dotfiles) ===

# Rotate X session logs
0 */3 * * * /bin/sh -c "/usr/sbin/logrotate -s $HOME/.local/state/xsession/logrotate.status $HOME/.config/logrotate/xsession.conf >> $HOME/.local/state/xsession/logrotate.log 2>&1"

# Mirror Google Calendar for khal and the desktop reminders
*/5 * * * * $HOME/.local/bin/calendar-sync
