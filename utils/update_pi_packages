#!/usr/bin/env node
// Bump each pinned `npm:<name>@<version>` package in pi's settings to its latest release.
// `pi update` leaves pinned versions alone, so this does it for the update PRs.
// Prints one `name old -> new` line per bump.
import { execFileSync } from 'node:child_process';
import { readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const SETTINGS = join(import.meta.dirname, '..', 'home', '.pi', 'agent', 'settings.json');
const PINNED = /^npm:((?:@[^/@]+\/)?[^@]+)@(\d[^@]*)$/;

let text = readFileSync(SETTINGS, 'utf8');
for (const spec of JSON.parse(text).packages ?? []) {
	if (typeof spec !== 'string') continue;
	const match = PINNED.exec(spec);
	if (!match) continue;
	const [, name, current] = match;
	const latest = execFileSync('npm', ['view', name, 'version'], { encoding: 'utf8' }).trim();
	if (latest === current) continue;
	// replace the quoted string so the file keeps its formatting
	text = text.replace(JSON.stringify(spec), JSON.stringify(`npm:${name}@${latest}`));
	console.log(`${name} ${current} -> ${latest}`);
}
writeFileSync(SETTINGS, text);
