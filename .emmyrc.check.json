{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "?.lua",
      "?/init.lua"
    ]
  },
  "workspace": {
    "ignoreGlobs": [
      "spec/libs/**"
    ],
    "library": [
      "$VIMRUNTIME",
      {
        "path": "$NVIM_PACK",
        "ignoreGlobs": [
          "*/*/*/[!l]*/**",
          "*/*/*/l[!u]*/**",
          "*/*/*/lu[!a]*/**",
          "*/*/*/lua?*/**",
          "*/*/*/*.lua",
          "*/*/plenary.nvim/lua/plenary/busted.lua"
        ]
      },
      "home/.config/nvim/spec/libs/yo-dawg.nvim/lua",
      "home/.config/nvim/spec/libs/busted/library",
      "home/.config/nvim/spec/libs/luassert/library"
    ]
  },
  "diagnostics": {
    "disable": [
      "unnecessary-if"
    ]
  }
}
