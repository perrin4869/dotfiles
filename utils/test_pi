#!/usr/bin/env node
// Start pi with the installed config over RPC and list its commands. pi installs missing packages on
// startup, with npm's output on stderr, and reports packages that fail to install or load there as
// `Error:` or `Warning:` lines.
import { spawn } from 'node:child_process';
import { mkdtempSync, rmSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { argv, exit, stderr } from 'node:process';
import { createInterface } from 'node:readline';

const TIMEOUT_MS = 5 * 60 * 1000;
// commands from our own extensions, which pi loads from ~/.pi/agent/extensions rather than as packages
const EXPECTED_COMMANDS = ['opusplan'];

const pi = argv[2] ?? 'pi';
// an empty project, so no project settings or trust prompts apply
const cwd = mkdtempSync(join(tmpdir(), 'test-pi-'));
const child = spawn(pi, ['--mode', 'rpc', '--no-session'], { cwd, stdio: ['pipe', 'pipe', 'pipe'] });

let errors = '';
child.stderr.on('data', (chunk) => (errors += chunk));

function finish(message, output = errors) {
	clearTimeout(timer);
	child.kill();
	rmSync(cwd, { recursive: true, force: true });
	if (message !== undefined) {
		stderr.write(`${message}\n${output}`);
		exit(1);
	}
}

const timer = setTimeout(() => finish(`pi did not answer within ${TIMEOUT_MS / 1000}s`), TIMEOUT_MS);
child.on('error', (error) => finish(`cannot start pi: ${error.message}`));
child.on('exit', (code) => finish(`pi exited early with code ${code}`));

createInterface({ input: child.stdout }).on('line', (line) => {
	let message;
	try {
		message = JSON.parse(line);
	} catch {
		return;
	}
	if (message.type !== 'response' || message.command !== 'get_commands') return;
	child.removeAllListeners('exit');
	if (!message.success) return finish(`get_commands failed: ${line}`);
	const names = new Set(message.data.commands.map((c) => c.name));
	const missing = EXPECTED_COMMANDS.filter((name) => !names.has(name));
	if (missing.length > 0) return finish(`missing commands: ${missing.join(', ')}`);
	const problems = errors.split('\n').filter((l) => /^(Error|Warning):/.test(l));
	if (problems.length > 0) return finish('pi reported problems on startup:', `${problems.join('\n')}\n`);
	finish();
	console.log(`pi started cleanly with ${names.size} commands`);
});

child.stdin.write(`${JSON.stringify({ type: 'get_commands' })}\n`);
