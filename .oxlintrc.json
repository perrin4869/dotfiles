{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": ["**/node_modules"],
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"no-unused-vars": ["error", { "ignoreUsingDeclarations": true }]
	},
	"options": {
		"typeAware": true,
		"denyWarnings": true
	},
	"overrides": [
		{
			"files": ["**/test/*.test.ts"],
			"rules": {
				"typescript/no-floating-promises": "off"
			}
		}
	]
}
