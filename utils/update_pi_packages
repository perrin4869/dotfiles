#!/usr/bin/env node
// Bump each pinned `npm:<name>@<version>` package in pi's settings to its latest release.
// `pi update` leaves pinned versions alone, so this does it for the update PRs.
// Prints a markdown PR body: one bullet per bump, with what changed, taken from the release notes, else the repo's
// changelog, else the list of commits.
import { execFile } from 'node:child_process';
import { writeFile } from 'node:fs/promises';
import { setTimeout as sleep } from 'node:timers/promises';
import { promisify } from 'node:util';
import extensions from '../home/.pi/agent/extensions/package.json' with { type: 'json' };
import settings from '../home/.pi/agent/settings.json' with { type: 'json' };

const execFileAsync = promisify(execFile);

// an npm source pinned to an exact version, which is the only kind this script knows how to bump
const PINNED_SPEC = /^npm:((?:@[^/@]+\/)?[^@]+)@(\d[^@]*)$/;

const parsePin = (spec) => {
	const match = PINNED_SPEC.exec(spec);
	if (!match) throw new Error(`${spec}: expected npm:<name>@<version>`);
	return { name: match[1], current: match[2] };
};

// `work` tried again while `shouldRetry` says the answer may change, pausing `wait`'s milliseconds before each try; a
// throw is tried again too, unless the attempts run out
async function retry(work, shouldRetry, { attempts = 3, wait = (_, attempt) => 1000 * 2 ** (attempt - 1) } = {}) {
	for (let attempt = 1; ; attempt++) {
		let answer;
		try {
			answer = await work();
		} catch (error) {
			if (attempt === attempts) throw error;
			await sleep(wait(undefined, attempt));
			continue;
		}
		if (!shouldRetry(answer) || attempt === attempts) return answer;
		await sleep(wait(answer, attempt));
	}
}

// The registry document at `path` under the package's base URL, the base itself being the packument; a scoped name
// has its slash escaped, which is how the registry spells it in a URL
const registryDocument = async (name, path, headers) => {
	const base = `https://registry.npmjs.org/${name.replace('/', '%2F')}`;
	const response = await fetch(`${base}${path}`, { headers });
	if (!response.ok) throw new Error(`${name}${path}: registry answered ${response.status}`);
	return response.json();
};

// The abbreviated packument carries `dist-tags` and `versions` at a third of the bytes, but drops `repository`, which
// the one-version document has for a single package
const getRegistry = async (name) => {
	const [abbreviated, latest] = await Promise.all([
		registryDocument(name, '', { accept: 'application/vnd.npm.install-v1+json' }),
		registryDocument(name, '/latest'),
	]);
	return { ...abbreviated, repository: latest.repository };
};

// The API's answer for `path` under `repo`, or undefined where it has none; `raw` asks for a file's bare contents
async function github(repo, path, { raw = false } = {}) {
	const token = process.env.GITHUB_TOKEN;
	const response = await retry(
		() =>
			fetch(`https://api.github.com/repos/${repo}/${path}`, {
				headers: {
					accept: raw ? 'application/vnd.github.raw+json' : 'application/vnd.github+json',
					// CI passes its own token, for the higher rate limit
					...(token && { authorization: `Bearer ${token}` }),
				},
			}),
		// a 5xx, a 429 or a 403 carrying `retry-after` may pass; a plain 403 is a permission answer
		(response) =>
			response.status >= 500 ||
			response.status === 429 ||
			(response.status === 403 && response.headers.has('retry-after')),
		// the server names the wait when it rate limits, and the backoff doubles otherwise
		{ wait: (response, attempt) => Number(response?.headers.get('retry-after')) * 1000 || 1000 * 2 ** (attempt - 1) },
	);
	if (response.status === 404) return undefined;
	if (!response.ok) throw new Error(`GitHub answered ${response.status} for ${repo}/${path}`);
	return raw ? response.text() : response.json();
}

// `owner/repo` of a registry document's repository field, when it is on GitHub; a repo name can hold dots, as in
// `pi-foo.nvim`, so only a trailing `.git` is dropped
const githubRepo = (repository) => {
	const url = typeof repository === 'string' ? repository : repository?.url;
	return /github\.com[/:]([^/]+\/[^/#?]+?)(?:\.git)?(?:[/#?]|$)/.exec(url ?? '')?.[1];
};

const parseVersion = (version) => /^(\d+)\.(\d+)\.(\d+)$/.exec(version)?.slice(1).map(Number);
const compareVersions = (a, b) => a[0] - b[0] || a[1] - b[1] || a[2] - b[2];

// stable versions published after `from` up to `to`, newest first
const versionsBetween = (versions, from, to) =>
	Object.keys(versions)
		.map((version) => [version, parseVersion(version)])
		.filter(([, parsed]) => parsed && compareVersions(parsed, from) > 0 && compareVersions(parsed, to) <= 0)
		.sort(([, a], [, b]) => compareVersions(b, a))
		.map(([version]) => version);

// notes are written for their own repo: point its issue references there, and keep mentions from notifying
const relink = (repo, body) =>
	body
		// `&` keeps an HTML entity such as `&#39;` intact
		.replace(/(^|[^\w/`&])#(\d+)\b/g, `$1${repo}#$2`)
		.replace(/(^|[^\w/`])@([A-Za-z\d](?:[A-Za-z\d-]*[A-Za-z\d])?)\b(?![./]\w)/g, '$1`@$2`');

// `load` called once per set of arguments; the promise is kept, so callers that arrive while it is pending share it
function once(load) {
	const loaded = new Map();
	return (...args) => {
		const key = args.join('\0');
		if (!loaded.has(key)) loaded.set(key, load(...args));
		return loaded.get(key);
	};
}

// The repo's own tags: asking git beats guessing at the API, which answers 404 for every wrong spelling and spends a
// request doing it
const tagsOf = once(async (repo) => {
	const { stdout } = await execFileAsync('git', ['ls-remote', '--tags', '--refs', `https://github.com/${repo}`], {
		encoding: 'utf8',
		timeout: 60_000,
	});
	return new Set(
		stdout
			.split('\n')
			.map((line) => line.slice(line.indexOf('refs/tags/') + 'refs/tags/'.length))
			.filter(Boolean),
	);
});

// A monorepo prefixes the package name, either the npm way or release-please's `<name>-v<version>` (as in
// `gotgenes/pi-packages`), and a single package uses `v`. One repo can carry both: `narumiruna/pi-extensions` tags
// every package *and* has repo-wide `v*` tags, so the namespaced tag wins where it exists.
const tagOf = (tags, name, version) => {
	const unscoped = name.replace(/^@[^/]+\//, '');
	return [`${name}@${version}`, `${unscoped}-v${version}`, `v${version}`, version].find((tag) => tags.has(tag));
};

const CHANGELOG_FILE = /^changelog\.(md|markdown)$/i;

// The changelog in a directory of the repo, read from its default branch: a repo can write releases there well before
// it tags them, if it tags them at all
const changelogIn = once(async (repo, directory) => {
	try {
		// listing the directory finds the changelog under any spelling in one request
		const listing = await github(repo, `contents/${directory}`);
		const entry = listing?.find(({ type, name }) => type === 'file' && CHANGELOG_FILE.test(name));
		return entry && { url: entry.html_url, text: await github(repo, `contents/${entry.path}`, { raw: true }) };
	} catch (error) {
		// an unreadable changelog must not take the release notes of the package's other versions with it
		console.error(`${repo}/${directory}: changelog unreadable: ${error.message}`);
		return undefined;
	}
});

// A monorepo package keeps its changelog in its own directory, which the registry names. One whose only changelog is
// at the repo's root has not come up yet, and that changelog may describe other packages, so it is reported rather
// than read
async function changelogOf(repo, directory) {
	if (!directory) return changelogIn(repo, '');
	const own = await changelogIn(repo, directory);
	if (own) return own;
	const root = await changelogIn(repo, '');
	if (root) {
		throw new Error(
			`${directory} has no changelog but ${root.url} does: a monorepo layout this script does not handle yet, decide ` +
				'whether that changelog describes the package',
		);
	}
	return undefined;
}

// the version a heading names, without its `v`: `## [v1.2.3] - 2024-05-01` gives `1.2.3`, `## 2.0.0-rc.1` gives
// `2.0.0-rc.1`
const HEADING_VERSION = /\bv?(\d+\.\d+\.\d+(?:-[\dA-Za-z.]+)?)\b/;
// an ATX heading: one to six `#`, then its text after a space or a tab, or nothing at all
const HEADING = /^(#{1,6})(?:[ \t]+(.*))?$/gm;

// What a changelog says about `version`: its heading reads `## 0.12.0 — 2026-11-10`, `## [1.2.3]` or `## v1.2.3`, and
// its section runs to the next heading of the same or a higher level; in a match, `[1]` is the `#` count and `[2]` the
// heading's text. `matchAll` matches lazily, a heading per step, so only headings down to the section's end are read
function changelogSection(text, version) {
	const headings = text.matchAll(HEADING);
	for (const heading of headings) {
		if (HEADING_VERSION.exec(heading[2] ?? '')?.[1] !== version) continue;
		const start = heading.index + heading[0].length;
		// the same iterator, so the search for the end resumes after the version's heading
		const end = headings.find((next) => next[1].length <= heading[1].length);
		return text.slice(start, end?.index).trim();
	}
	return '';
}

// One section of the body with the URL it came from, which is where to read the rest when it is cut; undefined when
// its source says nothing
function noteSection(repo, heading, url, body) {
	const trimmed = body?.trim();
	return trimmed ? { url, text: `### [${heading}](${url})\n\n${relink(repo, trimmed)}` } : undefined;
}

// How many commits a note lists before it defers to the compare view; a bump that spans several versions can carry
// hundreds
const COMMITS_SHOWN = 20;

// The commits from the pinned version up to the new one, which is the list dependabot publishes when no release
// describes the bump; the heading links the compare view, where the commits that did not fit are
async function commitsNote(repo, name, tags, current, version) {
	const [from, to] = [tagOf(tags, name, current), tagOf(tags, name, version)];
	// an untagged pin, or a dist-tag behind it, leaves nothing to compare against
	if (!from || !to) return undefined;
	const compare = `https://github.com/${repo}/compare/${from}...${to}`;
	// GitHub answers 404 when it cannot compare the two tags, which leaves the bump without a list
	const comparison = await github(repo, `compare/${from}...${to}`);
	if (!comparison) return undefined;
	const { commits, total_commits: total } = comparison;
	const listed = commits
		.slice(-COMMITS_SHOWN)
		.map(
			({ sha, commit }) =>
				`- [\`${sha.slice(0, 7)}\`](https://github.com/${repo}/commit/${sha}) ${commit.message.split('\n')[0]}`,
		);
	const more = total > listed.length ? `\n\n[See all ${total} commits](${compare})` : '';
	return noteSection(repo, `${current}...${version}`, compare, listed.length > 0 ? `${listed.join('\n')}${more}` : '');
}

// the release notes for a version, or undefined when the repo published no release for it
async function releaseNote(repo, tags, name, version) {
	const tag = tagOf(tags, name, version);
	// a repo can carry a tag without publishing a release for it
	const release = tag && (await github(repo, `releases/tags/${encodeURIComponent(tag)}`));
	return noteSection(repo, version, release?.html_url, release?.body);
}

// the changelog's section for a version, or undefined when the changelog says nothing about it
async function changelogNote(repo, directory, version) {
	const changelog = await changelogOf(repo, directory);
	return noteSection(repo, version, changelog?.url, changelog && changelogSection(changelog.text, version));
}

// `text` cut to fit in `room`: at the last line that fits, else at the last word, marked with an ellipsis; a code
// block the cut leaves open is closed
function cut(text, room) {
	const end = text.lastIndexOf('\n', room);
	const kept = end < 0 ? cutWord(text, room) : text.slice(0, end).trimEnd();
	return (kept.match(/^```/gm)?.length ?? 0) % 2 ? `${kept}\n\`\`\`` : kept;
}

// the mark a cut leaves where the rest of the note would be
const ELLIPSIS = '...';

// the last word of `text` that fits in `room` once the ellipsis is counted, for a text with no line short enough
function cutWord(text, room) {
	if (text.length <= room) return text;
	const width = Math.max(0, room - ELLIPSIS.length);
	// a word the cut lands inside is dropped, one it ends on is kept whole
	const sliced = text.slice(0, width);
	const words = /\s/.test(text[width]) ? sliced.trimEnd() : sliced.replace(/\s+\S*$/, '');
	return words ? `${words}${ELLIPSIS}` : '';
}

// What every stable version after `current` up to `version` changed, newest first; empty when the repo says nothing
// about them, in a release, a changelog or its commits
async function bumpNotes({ name, current, version, versions, repository }) {
	const repo = githubRepo(repository);
	if (!repo) {
		console.error(`${name}: no GitHub repository in the registry document, so no notes`);
		return '';
	}
	// a pin or a dist-tag that is not x.y.z leaves no range to walk; the caller turns this into a per-package error
	const [from, to] = [parseVersion(current), parseVersion(version)];
	if (!from || !to) throw new Error(`cannot read a version range from ${current} to ${version}`);

	const between = versionsBetween(versions, from, to);
	const tags = await tagsOf(repo);
	// a version's note comes from its release, else from the changelog's section for it, which a monorepo keeps in the
	// package's own directory
	const notes = (
		await Promise.all(
			between.map((version) =>
				releaseNote(repo, tags, name, version).then(
					(release) => release || changelogNote(repo, repository.directory, version),
				),
			),
		)
	).filter(Boolean);
	// nothing described any version in the bump, so the range from the pin to the new one covers all of it
	if (notes.length === 0) {
		const commits = await commitsNote(repo, name, tags, current, version);
		if (commits) notes.push(commits);
	}
	return notes;
}

// A package's notes joined into one markdown block within `limit`, ending where the rest is when they do not fit
function fit(notes, limit) {
	const separator = '\n\n';
	const kept = [];
	let size = 0;
	for (const { url, text } of notes) {
		const gap = kept.length > 0 ? separator.length : 0;
		if (size + gap + text.length <= limit) {
			size += gap + text.length;
			kept.push(text);
			continue;
		}
		// the link that says where the rest is comes out of the same allowance
		const more = `[More](${url})`;
		// a note that follows others ends the block where it stands; a first one is cut to leave the link its room
		if (kept.length > 0) return [...kept, more].join(separator);
		const room = limit - separator.length - more.length;
		return [room > 0 ? cut(text, room) : '', more].filter(Boolean).join(separator);
	}
	return kept.join(separator);
}

const bumpLine = ({ name, current, version }) =>
	`Bump [${name}](https://www.npmjs.com/package/${name}) from ${current} to ${version}`;

// a maintainer can move `latest` back below the pin, as when a bad release is pulled; like dependabot, keep the pin
function target(name, current, latest) {
	const [pinned, offered] = [parseVersion(current), parseVersion(latest)];
	if (!pinned || !offered || compareVersions(offered, pinned) >= 0) return latest;
	console.error(`${name}: latest is ${latest}, behind the pinned ${current}, so it stays`);
	return current;
}

// the registry's answer for each package in settings order, keeping only what the rest of the script reads from it
const registry = await Promise.all(
	(settings.packages ?? []).map(async (spec) => {
		const { name, current } = parsePin(spec);
		const { versions, repository, 'dist-tags': tags } = await getRegistry(name);
		return { name, current, version: target(name, current, tags.latest), versions, repository };
	}),
);

const packages = registry.map(({ name, version }) => `npm:${name}@${version}`);
const bumps = registry.filter(({ current, version }) => version !== current);

// pi records, per package, the version it last showed a changelog notice for, keyed by a JSON {"source","scope"} string,
// and writes the new one on the next start. A bump that leaves the record behind makes that start show a notice for a
// version we just pinned and rewrite settings.json, so move the records along with the pins.
const extensionChangelogVersions = Object.fromEntries(
	Object.entries(settings.extensionChangelogVersions ?? {}).map(([key, shown]) => {
		const { source, ...rest } = JSON.parse(key);
		// a record for the pin this run replaces moves with it; one for any other version is pi's to update
		const bump = bumps.find(({ name, current }) => source === `npm:${name}@${current}`);
		return bump ? [JSON.stringify({ source: `npm:${bump.name}@${bump.version}`, ...rest }), bump.version] : [key, shown];
	}),
);

// pi writes the file this way, so an update only shows the changed versions
await writeFile(
	new URL('../home/.pi/agent/settings.json', import.meta.url),
	JSON.stringify({ ...settings, packages, extensionChangelogVersions }, null, 2),
);

// the extension tests run against these packages' internals, so they follow the pinned versions
const tested = bumps
	.filter(({ name }) => name in extensions.devDependencies)
	.map(({ name, version }) => `${name}@${version}`);
if (tested.length > 0) {
	await execFileAsync(
		'npm',
		['install', '--workspace', 'home/.pi/agent/extensions', '--save-dev', '--save-exact', '--ignore-scripts', ...tested],
		// stdout is the PR body
		{ cwd: new URL('..', import.meta.url), stdio: ['ignore', 'ignore', 'inherit'] },
	);
}

const section = (bump, body) => `<details>\n<summary>${bumpLine(bump)}</summary>\n\n${body}\n</details>\n`;
const bullet = (bump) => `- ${bumpLine(bump)}`;

// A body is one GitHub comment of 65,536 characters, wrappers included, and `create-pull-request` truncates past it
const BODY_LIMIT = 65000;

// What each package's notes may take: an equal share of what the wrappers leave, and what the short ones leave unused
// going to the long ones
function allowances(sizes, budget) {
	if (sizes.length === 0) return [];
	const share = Math.floor(budget / sizes.length);
	const spare = budget - sizes.reduce((sum, size) => sum + Math.min(size, share), 0);
	const over = sizes.filter((size) => size > share).length;
	const extra = over > 0 ? Math.floor(spare / over) : 0;
	return sizes.map((size) => (size > share ? share + extra : size));
}

// each package's notes are independent, so they load together and still print in order
const gathered = await Promise.all(
	bumps.sort((a, b) => a.name.localeCompare(b.name)).map(async (bump) => {
		// notes that fail to load should not hold back the bump
		const notes = await bumpNotes(bump).catch((error) => {
			console.error(`${bump.name}: no notes: ${error.message}`);
			return [];
		});
		return { bump, notes };
	}),
);
// the wrappers and bullets come out of the same budget, and so does the newline each console.log adds
const overhead = gathered.reduce(
	(sum, { bump, notes }) => sum + (notes.length > 0 ? section(bump, '').length : bullet(bump).length) + 1,
	0,
);
const sizes = gathered.map(({ notes }) =>
	notes.reduce((sum, { text }, index) => sum + text.length + (index > 0 ? 2 : 0), 0),
);
const room = allowances(sizes, BODY_LIMIT - overhead);
for (const [index, { bump, notes }] of gathered.entries()) {
	const body = fit(notes, room[index]);
	console.log(body ? section(bump, body) : bullet(bump));
}
