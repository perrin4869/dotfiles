#!/bin/sh
# Check a downloaded release asset against the SHA-256 digest GitHub publishes for it.
# Usage: verify_github_asset <owner/repo> <tag> <asset> <file>
set -eu

REPO="$1"
TAG="$2"
NAME="$3"
FILE="$4"

expected="$(curl -fsSL "https://api.github.com/repos/$REPO/releases/tags/$TAG" |
  python3 -c 'import json, sys; print(next(a["digest"] for a in json.load(sys.stdin)["assets"] if a["name"] == sys.argv[1]))' "$NAME")"
actual="sha256:$(sha256sum "$FILE" | cut -d' ' -f1)"

if [ "$expected" != "$actual" ]; then
  echo "$NAME: digest mismatch (expected $expected, got $actual)" >&2
  exit 1
fi
echo "$NAME: OK"
