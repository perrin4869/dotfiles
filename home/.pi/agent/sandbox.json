{
  "enabled": true,
  "enableAccessRequestTool": true,
  "sandboxUserShell": false,
  "network": {
    "allowAllUnixSockets": true,
    "allowedDomains": [
      "npmjs.org",
      "*.npmjs.org",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "pypi.org",
      "*.pypi.org",
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "*.githubusercontent.com",
      "crates.io",
      "*.crates.io",
      "luarocks.org",
      "*.luarocks.org"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/home",
      "/run"
    ],
    "allowRead": [
      ".",
      "~/.local/bin/*",
      "~/.local/share/pipx/venvs/pre-commit",
      "~/.config/git",
      "~/.config/rtk",
      "~/.cache",
      "~/.npm",
      "~/.config/gh",
      "~/.pi/agent/bin",
      "~/.gnupg/pubring.kbx",
      "~/.gnupg/trustdb.gpg",
      "~/.gnupg/gpg.conf",
      "~/.ssh/known_hosts",
      "~/.Xauthority",
      "/run/user/*/gnupg",
      "/run/user/*/gh-approval-*.sock"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.cache",
      "~/.npm"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  }
}
