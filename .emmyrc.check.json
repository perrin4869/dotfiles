{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "?.lua",
      "?/init.lua"
    ]
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME",
      {
        "path": "$NVIM_PACK",
        "ignoreGlobs": [
          "*/*/*/[!l]*/**",
          "*/*/*/l[!u]*/**",
          "*/*/*/lu[!a]*/**",
          "*/*/*/lua?*/**",
          "*/*/*/*.lua"
        ]
      }
    ]
  },
  "diagnostics": {
    "disable": [
      "unnecessary-if"
    ]
  }
}
