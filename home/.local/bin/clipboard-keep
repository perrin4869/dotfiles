#!/bin/sh
# A copy only lives as long as the process that owns the selection, and a sandboxed command takes its
# processes with it, so an app that closes would otherwise take the text away. This owns the selection
# permanently instead: every copy has to take it from us, which unblocks the xclip holding it, and what
# the copier left behind becomes the one slot we hold. No event source, no polling, nothing on disk.
#
# A client that takes the selection and dies before we read it leaves nothing to read, and the slot is
# emptied rather than restored: restoring would revert the newest copy to the previous one, and an empty
# clipboard is the safer failure.
held=
while :; do
	# Hold the slot; xclip returns as soon as some other client takes the selection.
	printf '%s' "$held" | xclip -quiet -selection clipboard -in
	# Whatever is there now is the newest copy, including an explicit clear; unreadable means the copier
	# went away, so drop to empty.
	held=$(xclip -selection clipboard -o 2>/dev/null) || held=
done
