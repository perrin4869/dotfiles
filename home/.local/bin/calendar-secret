#!/bin/bash
# Print one Google OAuth client credential for vdirsyncer, caching both after a single YubiKey touch.
# vdirsyncer asks for the ID and the secret separately; the first call fills both cache files, so a sync
# never waits for the card twice, and later syncs never touch it at all.
set -euo pipefail

name=${1:?usage: calendar-secret client-id|client-secret}
case $name in
	client-id | client-secret) ;;
	*)
		echo "calendar-secret: unknown credential: $name" >&2
		exit 1
		;;
esac

data=${XDG_DATA_HOME:-$HOME/.local/share}/vdirsyncer
state=${XDG_STATE_HOME:-$HOME/.local/state}
entry=google/calendar-oauth-client
cache=$data/$name

session_bus() {
	if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
		printf '%s\n' "$DBUS_SESSION_BUS_ADDRESS"
	elif [[ -S /run/user/$(id -u)/bus ]]; then
		printf 'unix:path=/run/user/%s/bus\n' "$(id -u)"
	elif [[ -f $state/xsession/dbus-address ]]; then
		cat "$state/xsession/dbus-address"
	fi
}

notify() {
	local address
	address=$(session_bus)
	[[ -n $address ]] || return 0
	DBUS_SESSION_BUS_ADDRESS=$address notify-send -a calendar -u critical "$1" "$2" 2>/dev/null || true
}

sound() {
	# yubikey-touch-sound already plays one while the detector is running
	pgrep -f yubikey-touch-detector >/dev/null 2>&1 && return 0

	local file=/usr/share/sounds/freedesktop/stereo/dialog-information.oga
	[[ -f $file ]] || return 0

	local runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
	if command -v pw-play >/dev/null 2>&1; then
		XDG_RUNTIME_DIR=$runtime pw-play "$file" >/dev/null 2>&1 &
	elif command -v paplay >/dev/null 2>&1; then
		paplay "$file" >/dev/null 2>&1 &
	fi
}

if [[ -s $cache ]]; then
	cat "$cache"
	exit 0
fi

mkdir -p "$data"
chmod 700 "$data"
exec 9>"$data/.lock"
flock 9

# a concurrent callee may have filled the cache while this one waited for the lock
if [[ -s $cache ]]; then
	cat "$cache"
	exit 0
fi

notify "Google Calendar needs your YubiKey" "Touch it once to unlock the calendar sync credentials."
sound

secret=$(timeout 300 pass show "$entry") || {
	echo "calendar-secret: pass show $entry failed" >&2
	exit 1
}

id=$(sed -n 's/^client_id=//p' <<<"$secret" | head -n1)
client_secret=$(sed -n 's/^client_secret=//p' <<<"$secret" | head -n1)
if [[ -z $id || -z $client_secret ]]; then
	echo "calendar-secret: $entry needs client_id= and client_secret= lines" >&2
	exit 1
fi

umask 077
printf '%s' "$id" >"$data/client-id"
printf '%s' "$client_secret" >"$data/client-secret"
chmod 600 "$data/client-id" "$data/client-secret"
cat "$cache"
