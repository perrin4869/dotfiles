-- Specs describe the Neovim config in ../home/.config/nvim. nlua is busted's interpreter, so `vim` in a spec is the
-- real API. Run with `make test-nvim-spec`, or `busted` from the repository root.
return {
	_all = {
		coverage = false,
		lpath = 'home/.config/nvim/lua/?.lua;home/.config/nvim/lua/?/init.lua;home/.config/nvim/spec/?.lua;' ..
			'home/.local/share/nvim/lua-libs/yo-dawg.nvim/lua/?.lua',
		ROOT = { 'home/.config/nvim/spec' },
		lua = 'nlua',
	},
	default = {
		verbose = true,
	},
}
