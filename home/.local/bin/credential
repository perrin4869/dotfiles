#!/bin/bash
# Run a command that reads the shared credentials store (mail, calendar), unlocking its GPG key in gpg-agent first.
# The key's passphrase sits in the main pass store, so unlocking costs one YubiKey touch; gpg-agent then
# keeps the preset until it restarts or max-cache-ttl runs out, so later syncs and sends need no touch.
set -euo pipefail

store=${XDG_DATA_HOME:-$HOME/.local/share}/credentials
state=${XDG_STATE_HOME:-$HOME/.local/state}
passphrase_entry=gpg/credentials

if [[ ! -f $store/.gpg-id ]]; then
    echo "credential: no store at $store; see the Credentials section of the dotfiles README" >&2
    exit 1
fi

# the keygrips of the store key's encryption subkeys, which are what decryption asks the agent for
keygrips() {
    gpg --batch --with-colons --with-keygrip --list-secret-keys -- "$(head -n1 "$store/.gpg-id")" |
        awk -F: '$1 == "sec" || $1 == "ssb" { encrypts = $12 ~ /e/ } $1 == "grp" && encrypts { print $10 }'
}

cached() {
    gpg-connect-agent "KEYINFO $1" /bye | awk '$1 == "S" && $2 == "KEYINFO" { found = 1; exit $7 != "1" } END { if (!found) exit 1 }'
}

session_bus() {
    if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
        printf '%s\n' "$DBUS_SESSION_BUS_ADDRESS"
    elif [[ -S /run/user/$(id -u)/bus ]]; then
        printf 'unix:path=/run/user/%s/bus\n' "$(id -u)"
    elif [[ -f $state/xsession/dbus-address ]]; then
        cat "$state/xsession/dbus-address"
    fi
}

# succeeds only when someone can see the prompt, so cron never waits on a touch nobody knows about
notify() {
    local address
    address=$(session_bus)
    [[ -n $address ]] && DBUS_SESSION_BUS_ADDRESS=$address notify-send -a credential -u critical "$1" "$2" 2>/dev/null
}

locked() {
    local grip
    for grip in "${grips[@]}"; do
        cached "$grip" || return 0
    done
    return 1
}

unlock() {
    local reason passphrase grip
    if [[ $# -gt 0 ]]; then
        reason="$(ps -o comm= -p "$PPID" 2>/dev/null || echo something) wants to run: $*"
    else
        reason="Unlocking for this session."
    fi
    if ! notify "Touch the YubiKey to unlock credentials" \
        "$reason"$'\n'"One touch lasts until gpg-agent restarts or max-cache-ttl runs out."; then
        echo "credential: credentials are locked and there is no desktop session to ask for a touch" >&2
        exit 1
    fi

    passphrase=$(timeout 300 pass show "$passphrase_entry" | head -n1) || {
        echo "credential: pass show $passphrase_entry failed" >&2
        exit 1
    }
    for grip in "${grips[@]}"; do
        "$(gpgconf --list-dirs libexecdir)/gpg-preset-passphrase" --preset "$grip" <<<"$passphrase"
    done
}

# callers racing to autostart the agent see no secret keys until it is up
gpgconf --launch gpg-agent
mapfile -t grips < <(keygrips)
if [[ ${#grips[@]} -eq 0 ]]; then
    echo "credential: no secret encryption key for $(head -n1 "$store/.gpg-id")" >&2
    exit 1
fi

if locked; then
    mkdir -p "$state/credential"
    exec 9>"$state/credential/lock"
    flock 9
    # a concurrent caller may have unlocked while this one waited for the lock
    if locked; then
        unlock "$@"
    fi
    exec 9>&-
fi

export PASSWORD_STORE_DIR=$store
[[ $# -eq 0 ]] || exec "$@"
