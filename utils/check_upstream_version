#!/bin/sh
set -eu

DEP="$1"

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)
VERSION_FILE="$SCRIPT_DIR/../.external_versions/$DEP"

github_repo() {
  case "$1" in
    metals)    echo "scalameta/metals" ;;
    coursier)  echo "coursier/coursier" ;;
    iosevka)   echo "be5invis/Iosevka" ;;
    carapace)  echo "carapace-sh/carapace-bin" ;;
    nerdfonts) echo "ryanoasis/nerd-fonts" ;;
    *)
      echo "Unknown dependency: $1" >&2
      exit 1
      ;;
  esac
}

# A version we've deliberately rejected (e.g. a broken upstream release) gets
# its update PR closed with the "wontfix" label instead of merged. Checking
# for that PR - by its branch name, which GitHub keeps even after the branch
# itself is deleted - lets us skip re-proposing it without committing
# anything to the repo.
was_rejected() {
  dep="$1"
  version="$2"

  count="$(gh pr list --state closed --head "update/$dep/$version" --label wontfix --json number --jq 'length' 2>/dev/null)" || return 1
  [ "${count:-0}" -gt 0 ]
}

if [ ! -f "$VERSION_FILE" ]; then
  echo "Missing version file for $DEP" >&2
  exit 1
fi

REPO="$(github_repo "$DEP")"

LATEST="$(gh api "repos/$REPO/releases/latest" --jq '.tag_name')"

CURRENT="$(cat "$VERSION_FILE")"

if [ "$LATEST" != "$CURRENT" ] && ! was_rejected "$DEP" "$LATEST"; then
  printf '%s\n' "$LATEST"
fi
