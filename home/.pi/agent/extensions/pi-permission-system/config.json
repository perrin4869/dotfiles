{
	"yoloMode": false,
	"reviewLogFieldMaxWidth": 4000,
	"authorizerChain": ["bash-syntax"],
	"shellTools": {
		"bg_run": {
			"commandArgument": "command",
			"workdirArgument": "cwd"
		}
	},
	"permission": {
		"*": "allow",
		"path": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "allow",
			"*.npmrc.local": "deny",
			"~/.npmrc": "deny",
			"~/.ssh/*": "deny",
			"~/.gnupg/*": "deny",
			"~/.password-store/*": "deny",
			"~/.pi/agent/auth.json": "deny",
			"~/.config/gh/hosts.yml": "deny",
			"~/.claude/.credentials.json": "deny"
		},
		"bash": {
			"*": "ask",
			"ls": "allow",
			"ls *": "allow",
			"pwd": "allow",
			"cat *": "allow",
			"head *": "allow",
			"tail *": "allow",
			"wc *": "allow",
			"rg *": "allow",
			"grep *": "allow",
			"find *": "allow",
			"git status*": "allow",
			"git diff*": "allow",
			"git log*": "allow",
			"git show*": "allow",
			"cd": "allow",
			"cd *": "allow",
			"export *": "allow",
			"set *": "allow",
			"command -v *": "allow",
			"echo *": "allow",
			"sleep *": "allow",
			"true": "allow",
			"rm -rf *": "deny",
			"gh auth token*": "deny",
			"gh auth status --show-token*": "deny",
			"find * -delete*": "ask",
			"find * -exec*": "ask"
		},
		"external_directory": "ask"
	}
}
