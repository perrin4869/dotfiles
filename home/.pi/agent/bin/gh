#!/usr/bin/env bash
# gh, gated: stowed to ~/.pi/agent/bin/gh, a directory pi puts first on the PATH of the commands it runs, so nothing
# outside pi sees it. The real gh is whatever is left on PATH once this directory is dropped, so none is baked in.
set -u

self=$(cd -- "$(dirname -- "$0")" && pwd)
rest=
IFS=:
for dir in $PATH; do
	[ "$dir" = "$self" ] && continue
	rest=${rest:+$rest:}$dir
done
real=$(PATH=$rest command -v gh) || { echo "gh-approval: no gh on PATH" >&2; exit 127; }

agent=$HOME/.pi/agent
[ -n "${PI_CODING_AGENT_DIR:-}" ] && agent=$PI_CODING_AGENT_DIR

# the session writes the address it is reachable on from this machine, and the port, so nothing has to be resolved
verdict=
endpoint=
if [ -r "$agent/gh-approval.addr" ] && { IFS=' ' read -r host port; } < "$agent/gh-approval.addr" && [ -n "${host:-}" ] && [ -n "${port:-}" ]; then
	endpoint=1
	# stderr first, since redirections apply left to right and a failed connect should not print; on a group the failure
	# leaves the shell running, where one on exec would end the script silently
	if ! { printf '%s\0' "$PWD" "${GH_REPO:-}" "$#" "$@" >&3 && IFS= read -r verdict <&3; } 2>/dev/null 3<>"/dev/tcp/$host/$port"; then
		verdict=
	fi
fi

case $verdict in
allow) exec "$real" "$@" ;;
deny\ *)
	echo "gh-approval: ${verdict#deny }" >&2
	exit 1
	;;
esac

# a session exists and did not answer: refusing is the point, where running unchecked would defeat the gate
if [ -n "$endpoint" ]; then
	echo "gh-approval: the session did not answer; nothing was sent" >&2
	exit 1
fi

echo "gh-approval: no pi session to ask, running gh unchecked" >&2
exec "$real" "$@"
