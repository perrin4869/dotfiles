[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair google_calendar]
a = "google_calendar_local"
b = "google_calendar_remote"
collections = ["from a", "from b"]
metadata = ["displayname", "color"]
# Google is the source of truth; local edits lose on a conflict
conflict_resolution = "b wins"

[storage google_calendar_local]
type = "filesystem"
path = "~/.local/share/calendars/"
fileext = ".ics"

[storage google_calendar_remote]
type = "google_calendar"
token_file = "~/.local/share/vdirsyncer/google-token"
client_id.fetch = ["command", "pass", "google/calendar-client-id"]
client_secret.fetch = ["command", "pass", "google/calendar-client-secret"]
# Google rejects VTODO over CalDAV
item_types = ["VEVENT"]
